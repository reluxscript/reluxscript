// Error: no method named `as_ref` found for Wtf8Atom
// Wtf8Atom doesn't have .as_ref(), needs different conversion

plugin TestAtomAsRef {
    fn test(ident: &Ident) {
        if matches!(ident, Identifier) {
            // __inner is Ident, __inner.sym is Atom
            let name = ident.sym.clone();  // ERROR: .as_ref() doesn't exist on Wtf8Atom
            println!("{}", name);
        }
    }
}
