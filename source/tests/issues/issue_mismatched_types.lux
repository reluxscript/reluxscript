// Error: mismatched types
// Various type mismatches - this represents several different cases

plugin TestMismatchedTypes {
    fn test1(expr: &Expr) -> String {
        // Missing return value
        if matches!(expr, NullLiteral) {
            // returns () but expects String
        }
        "default".to_string()
    }
    
    fn test2(opt: &Option<String>) -> i32 {
        // Wrong return type
        if let Some(val) = opt {
            return val.clone();  // ERROR: returns String, expects i32
        }
        0
    }
    
    fn test3() {
        let x: String = 42;  // ERROR: expected String, found i32
    }
}
