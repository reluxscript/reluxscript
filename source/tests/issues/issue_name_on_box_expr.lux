// Error: no field `name` on type `&Box<Expr>`
// Trying to access .name on an Expr when it should be dereferenced to Ident first

plugin TestNameOnBoxExpr {
    fn test(expr: &Box<Expr>) {
        if matches!(expr, Identifier) {
            // expr is &Box<Expr>, needs unwrapping to get to Ident
            let name = expr.name.clone();  // ERROR: Box<Expr> doesn't have .name
        }
    }
}
