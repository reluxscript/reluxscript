// Error: no field `name` on type `&Pat`
// Similar to elements issue - trying to access fields after matches! without proper binding

plugin TestNameOnPat {
    fn test(binding: &Pat) {
        if matches!(binding, IdentifierPattern) {
            // binding is still &Pat, not &BindingIdent
            let name = binding.name.clone();  // ERROR: Pat doesn't have .name
        }
    }
}
