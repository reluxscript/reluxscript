// Error: no field `elements` on type `&ExprOrSpread`
// Wrong type - ExprOrSpread is not an array type

plugin TestElementsOnExprOrSpread {
    fn test(arg: &ExprOrSpread) {
        // Trying to access .elements on ExprOrSpread (which wraps an Expr)
        if arg.elements.len() > 0 {  // ERROR: ExprOrSpread doesn't have .elements
            return;
        }
    }
}
