/// Test: Type chain preservation after unwrapping
///
/// This tests that when we access a field on an unwrapped enum variant,
/// the field mapping is correctly applied.
///
/// Example: call.callee.name where callee is Callee enum
/// Should generate: call.callee.as_expr().unwrap().sym.to_string()
/// NOT: call.callee.as_expr().unwrap().name.to_string()


writer TestUnwrapChain {
    struct State {}

    fn init() -> State {
        State {}
    }

    /// Test accessing .name on an Ident after unwrapping from Callee
    pub fn visit_call_expression(node: &CallExpr) {
        // This should map .name to .sym with .to_string()
        // The issue: after .as_expr().unwrap(), we lose type info
        let callee_name = node.callee.name.clone();
    }

    /// Test accessing .name on the callee when it's an Ident
    pub fn visit_expression_statement(node: &ExpressionStatement) {
        // Access name on a deeply nested structure
        // This tests that type info flows through member access chains
        if matches!(node.expr, CallExpression) {
            let call = node.expr.clone();
            // Should map to .sym when callee is unwrapped to Ident
            let name = call.callee.name.clone();
        }
    }
}
