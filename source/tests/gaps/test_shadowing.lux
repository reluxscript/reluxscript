// Test: Implicit shadowing after matches!
// After matches!(expr, StringLiteral), expr should be shadowed with the unwrapped variant

plugin TestShadowing {
    fn visit_call_expression(node: &CallExpression) {
        if node.arguments.len() > 0 {
            let arg = &node.arguments[0].expr;

            if matches!(arg, StringLiteral) {
                // After the matches! check, arg should be shadowed to &Str
                // So we can access .value directly
                let val = &arg.value;
                let s = format!("String: {}", val);
            }
        }
    }
}
