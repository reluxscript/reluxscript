/// Process Component
///
/// Main entry point for processing a component function.
/// Mirrors babel-plugin-minimact/src/processComponent.cjs

// =============================================================================
// Level 2 Imports
// =============================================================================

use "./utils/helpers.lux" { get_component_name, is_component_name, escape_csharp_string };
use "./types/type_conversion.lux" { ts_type_to_csharp_type, infer_type };
use "./analyzers/hook_detector.lux" { is_custom_hook, get_hook_name };
use "./extractors/hooks.lux" { extract_hook };
use "./extractors/props.lux" { extract_props };
use "./extractors/local_variables.lux" { extract_local_variables };
use "./analyzers/prop_type_inference.lux" { infer_prop_types };

// =============================================================================
// Data Structures
// =============================================================================

pub struct ProcessedComponent {
    pub name: Str,
    pub props: Vec<PropInfo>,
    pub use_state: Vec<StateInfo>,
    pub use_client_state: Vec<StateInfo>,
    pub use_effect: Vec<EffectInfo>,
    pub use_ref: Vec<RefInfo>,
    pub use_markdown: Vec<MarkdownInfo>,
    pub use_template: Option<TemplateInfo>,
    pub event_handlers: Vec<EventHandlerInfo>,
    pub local_variables: Vec<LocalVariableInfo>,
    pub helper_functions: Vec<HelperFunctionInfo>,
    pub render_body: Option<Expression>,
    pub state_types: HashMap<Str, Str>,
    pub external_imports: HashSet<Str>,
}

pub struct PropInfo {
    pub name: Str,
    pub prop_type: Str,
    pub optional: bool,
}

pub struct StateInfo {
    pub name: Str,
    pub setter: Option<Str>,
    pub initial_value: Str,
    pub state_type: Str,
}

pub struct EffectInfo {
    pub body: Option<Expression>,
    pub dependencies: Option<Expression>,
}

pub struct RefInfo {
    pub name: Str,
    pub initial_value: Str,
}

pub struct MarkdownInfo {
    pub name: Str,
    pub setter: Str,
    pub initial_value: Str,
}

pub struct TemplateInfo {
    pub name: Str,
    pub props: HashMap<Str, Str>,
}

pub struct EventHandlerInfo {
    pub name: Str,
    pub params: Vec<Str>,
    pub body: Option<Expression>,
}

pub struct LocalVariableInfo {
    pub name: Str,
    pub var_type: Str,
    pub initial_value: Option<Expression>,
}

pub struct HelperFunctionInfo {
    pub name: Str,
    pub params: Vec<ParamInfo>,
    pub return_type: Str,
    pub is_async: bool,
    pub body: Option<BlockStatement>,
}

pub struct ParamInfo {
    pub name: Str,
    pub param_type: Str,
}

// =============================================================================
// Main Function
// =============================================================================

/// Process a function declaration and extract component info
pub fn process_component(node: &FunctionDeclaration) -> Option<ProcessedComponent> {
    // 1. Get component name
    let name = get_component_name(node, None)?;

    // 2. Check if it's a custom hook (skip for now)
    if is_custom_hook_by_name(&name) {
        return None;
    }

    // 3. Validate component name (must be PascalCase)
    if !is_component_name(&name) {
        return None;
    }

    // 4. Initialize component
    let mut component = ProcessedComponent {
        name: name.clone(),
        props: vec![],
        use_state: vec![],
        use_client_state: vec![],
        use_effect: vec![],
        use_ref: vec![],
        use_markdown: vec![],
        use_template: None,
        event_handlers: vec![],
        local_variables: vec![],
        helper_functions: vec![],
        render_body: None,
        state_types: HashMap::new(),
        external_imports: HashSet::new(),
    };

    // 5. Extract props from parameters
    if !node.params.is_empty() {
        component.props = extract_props(&node.params[0]);
    }

    // 6. Extract hooks and local variables from body
    if let Some(ref body) = node.body {
        extract_hooks_from_body(body, &mut component);
        extract_local_variables_from_body(body, &mut component);
        extract_helper_functions(body, &mut component);
        extract_render_body(body, &mut component);
    }

    // 7. Infer prop types from usage
    if let Some(ref body) = node.body {
        infer_prop_types(&mut component, body);
    }

    Some(component)
}

// =============================================================================
// Helper Functions
// =============================================================================

/// Check if name starts with "use" and has an uppercase letter after
fn is_custom_hook_by_name(name: &Str) -> bool {
    if !name.starts_with("use") {
        return false;
    }
    if name.len() <= 3 {
        return false;
    }
    // Check if 4th character (index 3) is uppercase
    if let Some(c) = name.chars().nth(3) {
        c.is_uppercase()
    } else {
        false
    }
}

/// Extract hooks from function body
fn extract_hooks_from_body(body: &BlockStatement, component: &mut ProcessedComponent) {
    for stmt in &body.stmts {
        if let Statement::VariableDeclaration(var_decl) = stmt {
            for decl in &var_decl.declarations {
                if let Some(ref init) = decl.init {
                    if let Expression::CallExpression(ref call) = init {
                        extract_hook(call, decl, component);
                    }
                }
            }
        }
    }
}

/// Extract local variables from function body
fn extract_local_variables_from_body(body: &BlockStatement, component: &mut ProcessedComponent) {
    for stmt in &body.stmts {
        if let Statement::VariableDeclaration(var_decl) = stmt {
            extract_local_variables(var_decl, component);
        }
    }
}

/// Extract helper functions declared inside the component
fn extract_helper_functions(body: &BlockStatement, component: &mut ProcessedComponent) {
    for stmt in &body.stmts {
        if let Statement::FunctionDeclaration(func) = stmt {
            if let Some(ref id) = func.id {
                let func_name = id.name.clone();

                // Skip if it's a custom hook
                if is_custom_hook_by_name(&func_name) {
                    continue;
                }

                // Extract params
                let params: Vec<ParamInfo> = func.params.iter().map(|param| {
                    if let Pattern::Identifier(id) = param {
                        let param_type = if let Some(ref type_ann) = id.type_annotation {
                            ts_type_to_csharp_type(&type_ann.type_annotation)
                        } else {
                            "dynamic".into()
                        };
                        ParamInfo {
                            name: id.name.clone(),
                            param_type,
                        }
                    } else {
                        ParamInfo {
                            name: "param".into(),
                            param_type: "dynamic".into(),
                        }
                    }
                }).collect();

                // Extract return type
                let return_type = if let Some(ref ret_type) = func.return_type {
                    ts_type_to_csharp_type(&ret_type.type_annotation)
                } else {
                    "void".into()
                };

                component.helper_functions.push(HelperFunctionInfo {
                    name: func_name,
                    params,
                    return_type,
                    is_async: func.is_async,
                    body: func.body.clone(),
                });
            }
        }
    }
}

/// Extract render body (return statement with JSX)
fn extract_render_body(body: &BlockStatement, component: &mut ProcessedComponent) {
    for stmt in &body.stmts {
        if let Statement::ReturnStatement(ret) = stmt {
            if let Some(ref arg) = ret.argument {
                component.render_body = Some(arg.clone());
            }
        }
    }
}
